<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- InvariantGlobalization must stay OFF: Reqnroll resolves feature languages through
         CultureInfo and throws under invariant mode, and SpecReport supports localized
         Gherkin (SPEC 4.3), so culture data is load-bearing rather than incidental. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- Shared NuGet metadata. Individual packable projects set PackageId/Description. -->
  <PropertyGroup>
    <Version>0.1.0-alpha</Version>
    <Authors>Karzone</Authors>
    <Company>Karzone</Company>
    <Copyright>Copyright (c) 2026 Karzone</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>reqnroll;bdd;gherkin;html-report;test-report;living-documentation;cucumber</PackageTags>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
