<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SpecReport.Cli</RootNamespace>

    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>specreport</ToolCommandName>
    <PackageId>SpecReport.Cli</PackageId>
    <Description>dotnet tool that turns a Reqnroll run's Cucumber Messages (NDJSON) into a single self-contained HTML report. Works on any Reqnroll project.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../SpecReport.Core/SpecReport.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
