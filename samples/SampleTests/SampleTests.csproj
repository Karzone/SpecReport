<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>

    <!-- The sample deliberately contains failing scenarios: it exists to produce a realistic
         NDJSON fixture, not to go green. CI runs it with `dotnet test || true` semantics. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.10.3" />
    <PackageReference Include="MSTest.TestFramework" Version="3.10.3" />
    <!-- MSTest (not xUnit): xUnit has no runner-level attachment support.
         See docs/reqnroll-api-notes.md 3. -->
    <PackageReference Include="Reqnroll.MsTest" Version="3.3.4" />
  </ItemGroup>

  <ItemGroup>
    <None Update="reqnroll.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
